# KanoonRAG Environment Variables

# Groq API (free tier)
GROQ_API_KEY=your_groq_api_key_here

# Indian Kanoon API (used only by seed script)
KANOON_API_TOKEN=your_kanoon_api_token_here

# JWT Secret (generate a random string)
JWT_SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/kanoonrag.db

# ChromaDB
CHROMA_PERSIST_DIR=./data/chroma_db

# File Storage
UPLOAD_DIR=./data/uploads
KANOON_CACHE_DIR=./data/kanoon_cache


#Gemini
GEMINI_KEY=test